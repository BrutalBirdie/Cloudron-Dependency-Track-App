# Dependency-Track configuration. Restart the app after changes.
# Every property can be set as an environment variable - https://docs.dependencytrack.org/getting-started/configuration/
# e.g. dt.datasource.pool.max-size becomes DT_DATASOURCE_POOL_MAX_SIZE

# export DT_DATASOURCE_POOL_MAX_SIZE=15
# export JAVA_OPTIONS="${JAVA_OPTIONS} -XX:MaxRAMPercentage=75.0"

# If project metrics updates fail with "canceling statement due to user request", raise the query timeout (default 60000) and lower the metrics worker concurrency (default 5)
# export DT_DATASOURCE_QUERY_TIMEOUT_MS=300000
# export DT_DEX_ENGINE_ACTIVITY_WORKER_METRICS_UPDATE_MAX_CONCURRENCY=2
