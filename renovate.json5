{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        // picks up the `# renovate:` annotated ARGs in the Dockerfile
        "customManagers:dockerfileVersions"
    ],
    "assignees": ["BrutalBirdie"],
    "assignAutomerge": true,
    "automerge": true,
    // GitHub auto-merge needs branch protection, which would block the release workflows pushing to main
    "platformAutomerge": false,
    "packageRules": [
        {
            "matchUpdateTypes": ["major"],
            "automerge": false
        },
        {
            // the apiserver and frontend are released together with the same version
            "matchPackageNames": ["DependencyTrack/dependency-track", "DependencyTrack/frontend"],
            "groupName": "Dependency-Track"
        }
    ]
}
